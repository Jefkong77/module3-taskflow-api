{
  "info": {
    "name": "Module 3 TaskFlow Task 6 AI Summary",
    "description": "Run on a fresh server with your private provider environment configured. Creates two synthetic tasks, requests two model summaries, and cleans up both tasks. Check the model counts and meaning manually; assertion scripts verify status, type, nonempty text and task state. No key is stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "aiPendingId",
      "value": ""
    },
    {
      "key": "aiCompleteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Create pending task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Review assignment requirements\", \"completed\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"aiPendingId\", String(pm.response.json().id));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create completed task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Build the task API\", \"completed\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"aiCompleteId\", String(pm.response.json().id));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Summarize mixed task states",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/summary"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Plain-English text response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\"); pm.expect(pm.response.text().trim().length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Complete the pending task",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{aiPendingId}}/complete"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Completion saved\", () => pm.expect(pm.response.json().completed).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Summarize completed work",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/summary"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Plain-English text response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\"); pm.expect(pm.response.text().trim().length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Check summary did not change tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Both stored tasks remain complete\", () => { const tasks=pm.response.json(); pm.expect(tasks).to.have.length(2); pm.expect(tasks.every(t => t.completed === true)).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Delete first test task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{aiPendingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Delete second test task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{aiCompleteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Check empty task summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/summary"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Plain-English text response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\"); pm.expect(pm.response.text().trim().length).to.be.above(0); });",
              "pm.test(\"Empty-list statement\", () => pm.expect(pm.response.text()).to.eql(\"There are no tasks. Nothing is pending or completed.\"));"
            ]
          }
        }
      ]
    }
  ]
}
